{
  "name": "canary",
  "private": true,
  "version": "1.0.0",
  "description": "Graph-aware authorization engine for AI agents",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm --filter \"./packages/**\" run test && pnpm --filter \"./services/**\" run test",
    "test:e2e": "pnpm --filter @canary/e2e run test",
    "test:perf": "pnpm --filter @canary/e2e run test:perf",
    "lint": "pnpm --filter \"*\" run lint",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.0"
}
